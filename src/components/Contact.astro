---
// Contact: full-bleed night scene with parallax layers and the contact form.
import Button from "./Button.astro";
import { site } from "../data/site";

// Back to front, with how far each layer lags while the section scrolls in.
const layers = [
  { n: 8, c: 0.02 },
  { n: 7, c: 0.06 },
  { n: 6, c: 0.1 },
  { n: 5, c: 0.14 },
  { n: 4, c: 0.2 },
  { n: 3, c: 0.26 },
  { n: 2, c: 0 },
  { n: 1, c: 0.34 },
];
---

<section id="contact" class="cband" aria-label="Contact">
  {
    layers.map(({ n, c }) => (
      <div class="clayer nt" data-c={c} style={`background-image:url(/layers/night${n}.png)`} />
    ))
  }
  <div class="cgrain"></div>
  <div class="cinner">
    <div class="ctext">
      <h2><span>05</span>Let's build something together</h2>
      <p>Open to summer 2027 software engineering internships. Send me a message and I'll get back to you.</p>
    </div>
    <form class="cform" novalidate data-email={site.email} data-endpoint={site.formEndpoint}>
      <div class="row">
        <label for="cf-name">Name<input id="cf-name" name="name" autocomplete="name" required /></label>
        <label for="cf-email"
          >Your email<input id="cf-email" name="email" type="email" autocomplete="email" required /></label
        >
      </div>
      <label for="cf-msg">Message<textarea id="cf-msg" name="message" rows="5" required></textarea></label>
      <!-- Spam trap: hidden from people, filled in by bots. Formspree silently drops submissions that include it. -->
      <label class="trap" aria-hidden="true">Leave this empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      <div class="send">
        <Button type="submit" variant="primary" flap="var(--sky)">Send message</Button>
        <span id="cf-status" role="status"></span>
      </div>
    </form>
  </div>
</section>

<style>
  .cband {
    position: relative;
    max-width: none;
    margin-top: clamp(70px, 9vw, 120px);
    padding: 0;
    min-height: max(820px, 100vh);
    overflow: hidden;
    background: #230b2b;
  }
  /* Fade from the page background into the scene. */
  .cband::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 140px;
    z-index: 6;
    background: linear-gradient(var(--ground), transparent);
    pointer-events: none;
  }
  .clayer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .clayer.nt {
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center bottom;
    image-rendering: pixelated;
  }
  .cgrain {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background-image: var(--grain);
  }
  .cinner {
    position: relative;
    z-index: 5;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(130px, 16vh, 180px) max(5vw, 16px) 120px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }
  .ctext h2 {
    color: var(--text);
    font-size: clamp(38px, 5.4vw, 68px);
    line-height: 1;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(15, 9, 20, 0.6);
  }
  .ctext h2 span {
    display: block;
    margin-bottom: 10px;
  }
  .ctext p {
    color: #d9d2f2;
    font-size: 19px;
  }
  .cform {
    background: rgba(31, 20, 52, 0.88);
    border: 1px solid rgba(194, 178, 255, 0.22);
    backdrop-filter: blur(6px);
    padding: 26px;
    display: grid;
    gap: 14px;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
    box-shadow: 0 24px 60px rgba(29, 20, 64, 0.35);
  }
  .cform .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .cform label {
    display: grid;
    gap: 6px;
    font: 600 13px var(--font-mono);
    color: var(--lav);
  }
  .cform input,
  .cform textarea {
    font: 16px/1.5 var(--font-body);
    color: var(--text);
    background: #2a1f58;
    border: 1px solid var(--line);
    padding: 12px 14px;
    border-radius: 0;
    width: 100%;
    min-height: 46px;
    resize: vertical;
  }
  .cform input:focus,
  .cform textarea:focus {
    outline: none;
    border-color: var(--rose);
    box-shadow: 0 0 0 1px var(--rose);
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .cform [aria-invalid="true"] {
    border-color: #ff8aa6;
  }
  .send {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  /* Prototype: 22px padding, no border; Button keeps its 1px border, so 21px gives the same width. */
  .send :global(.btn) {
    padding: 0 21px;
  }
  #cf-status {
    font-size: 14px;
    color: var(--sub);
  }

  @media (max-width: 860px) {
    .cinner {
      grid-template-columns: 1fr;
      padding-top: 120px;
      padding-bottom: min(300px, 62vw);
    }
    .cband {
      min-height: 0;
    }
    .clayer.nt {
      background-size: auto 100%;
    }
  }
  @media (max-width: 600px) {
    .cform .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const band = document.querySelector<HTMLElement>("#contact")!;

  // Parallax: while the section scrolls in, each layer lags by its distance from the viewport top × factor.
  const layers = [...band.querySelectorAll<HTMLElement>(".clayer[data-c]")];
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    const cpar = () => {
      ticking = false;
      const t = band.getBoundingClientRect().top;
      if (t > innerHeight || t < -band.offsetHeight) return;
      const off = Math.max(0, t);
      layers.forEach((l) => {
        l.style.transform = `translate3d(0,${(off * +l.dataset.c!).toFixed(1)}px,0)`;
      });
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(cpar);
        }
      },
      { passive: true },
    );
    cpar();
  }

  // Form: with an endpoint it POSTs there; without one it opens the visitor's email app.
  const form = band.querySelector<HTMLFormElement>(".cform")!;
  const st = band.querySelector<HTMLElement>("#cf-status")!;
  const email = form.dataset.email ?? "";
  const endpoint = form.dataset.endpoint ?? "";

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
    let bad = false;
    for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")) {
      const ok = !!el.value.trim() && (el.type !== "email" || /^\S+@\S+\.\S+$/.test(el.value));
      el.setAttribute("aria-invalid", String(!ok));
      if (!ok) bad = true;
    }
    if (bad) {
      st.textContent = "Please fill in every field with a valid email.";
      return;
    }
    if (!endpoint) {
      location.href = `mailto:${email}?subject=${encodeURIComponent("Portfolio message from " + f.name)}&body=${encodeURIComponent(f.message + "\n\n— " + f.name + " (" + f.email + ")")}`;
      st.textContent = "Opening your email app… if nothing happens, email " + email + ".";
      return;
    }
    const btn = form.querySelector("button")!;
    btn.disabled = true;
    st.textContent = "Sending…";
    try {
      // Formspree uses `subject` for the notification email's subject and `email` as its Reply-To.
      const body = new FormData(form);
      body.set("subject", "Portfolio message from " + f.name);
      const r = await fetch(endpoint, { method: "POST", headers: { Accept: "application/json" }, body });
      if (!r.ok) throw new Error(String(r.status));
      form.reset();
      st.textContent = "Thanks, your message was sent.";
    } catch {
      st.textContent = "Couldn't send right now. Please email " + email + " instead.";
    }
    btn.disabled = false;
  });
</script>
