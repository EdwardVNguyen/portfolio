---
// Site footer: name and Back to top, section links, social icons, and a bottom line.
import Button from "./Button.astro";
import { site, sections } from "../data/site";
---

<footer class="foot">
  <div class="fgrid">
    <div class="fbrand">
      <div class="fname">{site.name}</div>
      <p>Full-stack developer, University of Houston.</p>
      <Button href="#" variant="outline" flap="var(--amber)">Back to top ↑</Button>
    </div>
    <nav class="fnav" aria-label="Footer">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>
    <div class="fsoc">
      <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
      </a>
      <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor" /><g fill="var(--ground)"><circle cx="7.4" cy="7.3" r="1.7" /><rect x="5.9" y="10" width="3" height="8.5" /><path d="M11 10h2.9v1.3c.5-.9 1.6-1.6 3-1.6 2.3 0 3.1 1.5 3.1 3.9v4.9h-3v-4.4c0-1.1-.3-1.8-1.3-1.8-1.1 0-1.7.8-1.7 2v4.2h-3z" /></g></svg>
      </a>
      <a href={`mailto:${site.email}`} aria-label="Email" title={site.email}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="M3 6l9 7 9-7" /></svg>
      </a>
    </div>
  </div>
  <div class="fbase"><span>© 2026 {site.name}</span><span>Built with determination</span></div>
</footer>

<style>
  .foot {
    background: var(--footer);
    margin-top: -1px;
    position: relative;
    padding: 30px max(5vw, 16px) 26px;
    font-size: 15px;
    color: var(--sub);
  }
  .fgrid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    gap: 0;
  }
  .fgrid > * {
    padding: 14px clamp(20px, 4vw, 48px);
  }
  .fgrid > * + * {
    border-left: 2px solid var(--sky);
  }
  /* Scoped styles add an attribute to every selector part, so `.fgrid > *` outranks a lone class; qualify the overrides. */
  .fgrid > .fbrand {
    padding-left: 0;
  }
  .fname {
    font: 700 30px/1 var(--font-head);
    color: var(--rose);
  }
  .fbrand p {
    margin: 0.7em 0 1.2em;
  }
  .fnav {
    display: grid;
    align-content: start;
  }
  .fnav a {
    color: var(--text);
    text-decoration: none;
    font: 600 14px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    /* Prototype uses 8px padding + 4px gap (34px tall); stretch each link to a 44px tap target. */
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .fnav a:hover {
    color: var(--rose);
  }
  .fsoc {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .fgrid > .fsoc {
    padding-right: 0;
  }
  .fsoc a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--text);
  }
  .fsoc a:hover {
    color: var(--sky);
  }
  .fsoc svg {
    width: 28px;
    height: 28px;
  }
  .fbase {
    max-width: 1180px;
    margin: 28px auto 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font: 12px var(--font-mono);
  }
  @media (max-width: 700px) {
    /* Halves, except the icon column never shrinks below its three icons (avoids sideways scroll at 360px). */
    .fgrid {
      grid-template-columns: 1fr minmax(min-content, 1fr);
    }
    .fgrid > .fbrand {
      grid-column: 1 / -1;
      padding-right: 0;
    }
    .fgrid > * + * {
      border-left: 0;
    }
    .fgrid > .fnav {
      padding-left: 0;
    }
    .fsoc {
      border-left: 2px solid var(--sky) !important;
      grid-template-columns: repeat(3, 46px);
      align-content: start;
    }
  }
</style>
