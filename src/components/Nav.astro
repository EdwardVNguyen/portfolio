---
import { sections } from "../data/site";
---

<nav aria-label="Sections">
  {sections.map((s) => <a class="flip" href={`#${s.id}`}>{s.label}</a>)}
</nav>

<script>
  // Highlight the link for the last section whose top has passed 40% of the way down the screen.
  // Short sections (like Skills) still get their turn, and nothing is highlighted over the hero.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Sections"] a')];
  const sections = [...document.querySelectorAll<HTMLElement>("main section[id]")];
  let current: string | undefined;
  let ticking = false;

  const update = () => {
    ticking = false;
    const line = innerHeight * 0.4;
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    const id = atBottom ? sections.at(-1)?.id : sections.filter((s) => s.getBoundingClientRect().top <= line).at(-1)?.id;
    if (id === current) return;
    current = id;
    for (const a of links) {
      const on = a.getAttribute("href") === `#${id}`;
      a.classList.toggle("on", on);
      if (on) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  };

  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  addEventListener("resize", update);
  update();
</script>

<style>
  nav {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    gap: 2px;
    padding: 5px;
    background: rgba(16, 11, 32, 0.82);
    backdrop-filter: blur(10px);
    font: 600 13px var(--font-mono);
    max-width: calc(100vw - 24px);
    overflow-x: auto;
  }
  a {
    --flap: var(--rose);
    --flap-ink: #fff;
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--sub);
    text-decoration: none;
    padding: 0 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* Tighten so all five links fit on a 360px phone instead of scrolling. */
  @media (max-width: 420px) {
    nav {
      font-size: 12px;
    }
    a {
      padding-inline: 5px;
    }
  }
  a.on {
    --flap: var(--sky);
    --flap-ink: var(--ground);
    color: #fff;
    background: var(--rose);
  }
</style>
