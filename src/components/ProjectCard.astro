---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** Position in the single-column (mobile) order. */
  order: number;
}

const { project: p, order } = Astro.props;
---

<article class="pc" style={`--o:${order}`}>
  <div class="shot" style={`aspect-ratio:${p.aspect}`}>
    {
      p.img ? (
        <img src={p.img} alt={`${p.name} screenshot`} loading="lazy" decoding="async" />
      ) : (
        <div class="ph" style={`--h1:${p.placeholder[0]};--h2:${p.placeholder[1]}`}>
          <div>
            <b>{p.name}</b>
            <small>screenshot · {p.aspect.replace("/", ":")}</small>
          </div>
        </div>
      )
    }
  </div>
  <div class="pi">
    <h3>{p.name}{p.status && <span class="status">{p.status}</span>}</h3>
    <div class="cat">{p.category} · {p.meta}</div>
    <p>{p.description}</p>
    <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
    {
      p.url && (
        <div class="links">
          <a href={p.url}>source ↗</a>
        </div>
      )
    }
  </div>
</article>

<style>
  .pc {
    flex: 1 1 100%;
    display: flex;
    flex-direction: column;
    background: var(--card);
    color: var(--text);
    overflow: hidden;
    clip-path: var(--cut);
    transition: transform 0.3s;
  }
  .pc:hover {
    transform: translateY(-4px);
  }

  .shot {
    position: relative;
    overflow: hidden;
    background: #cbbff0;
  }
  .shot img,
  .ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 0.9, 0.24, 1);
  }
  .pc:hover .shot img,
  .pc:hover .ph {
    transform: scale(1.04);
  }

  /* Placeholder panel shown until a screenshot exists. */
  .ph {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 20px;
    background:
      radial-gradient(circle at 70% 20%, rgba(255, 255, 255, 0.75), transparent 55%),
      radial-gradient(rgba(29, 20, 64, 0.22) 1px, transparent 1.4px) 0 0 / 6px 6px,
      linear-gradient(160deg, var(--h1), var(--h2));
  }
  .ph b {
    font: 700 clamp(22px, 3vw, 40px) / 1 var(--font-head);
    color: #1d1440;
    opacity: 0.85;
  }
  .ph small {
    display: block;
    margin-top: 8px;
    font: 600 12px var(--font-mono);
    color: #2b1f5e;
    opacity: 0.7;
  }

  .pi {
    padding: 22px 26px 26px;
  }
  .pi h3 {
    font: 700 clamp(21px, 2.2vw, 28px) / 1.15 var(--font-head);
    margin: 0 0 4px;
  }
  .status {
    font: 600 11px var(--font-mono);
    padding: 2px 7px;
    background: var(--sky);
    color: var(--ground);
    margin-left: 8px;
    vertical-align: 3px;
  }
  .cat {
    color: var(--sub);
    font-size: 16px;
  }
  .pi p {
    font-size: 15px;
    margin: 0.7em 0 0;
    color: #d9d2f2;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 14px;
  }
  .tag {
    font: 600 12px var(--font-mono);
    padding: 3px 9px;
    background: #382b6e;
    color: var(--sky);
  }
  .links {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    font: 600 13px var(--font-mono);
  }

  /* Single column: the stacks are flattened (see Projects.astro) and cards follow data order. */
  @media (max-width: 700px) {
    .pc {
      order: var(--o);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc,
    .shot img,
    .ph {
      transition: none;
    }
  }
</style>
