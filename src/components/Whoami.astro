---
// Section 01: a short intro plus résumé and contact buttons.
import Button from "./Button.astro";
import { site } from "../data/site";
---

<section id="about">
  <h2><span>01</span>whoami</h2>
  <div class="about">
    <p>
      I'm a CS senior at the University of Houston, graduating May 2027. I build full-stack web apps with React, Go and
      PostgreSQL.
    </p>
    <p class="muted">
      Right now I'm building the frontend of a nonprofit's website as a volunteer, working on LuChess, and practicing
      for internship OAs. After graduation I'm heading to Georgia Tech's OMSCS.
    </p>
    <div class="btns">
      <Button href={site.resume} variant="primary" flap="var(--amber)">Résumé (PDF) ↓</Button>
      <Button href="#contact" variant="secondary" flap="var(--sky)">Contact</Button>
    </div>
  </div>
</section>

<style>
  .about {
    max-width: 760px;
  }
  .about p {
    max-width: 62ch;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 8px;
    margin-top: 22px;
  }
  .btns :global(.btn) {
    padding: 0 14px;
  }
</style>
