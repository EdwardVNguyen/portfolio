---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";
---

<Base title={`Page not found — ${site.name}`} description="This page doesn't exist." nav={false}>
  <main>
    <section class="lost">
      <h2><span>404</span>Page not found</h2>
      <p class="muted">There's nothing at this address. It may have moved, or the link has a typo.</p>
      <Button href="/" variant="primary" flap="var(--amber)">Back to the portfolio</Button>
    </section>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    align-content: center;
    justify-items: start;
    padding-top: 0;
  }
</style>
