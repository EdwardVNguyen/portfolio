// Cloudflare Workers config: serve the static Astro build from ./dist.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {}
}
